{
  "name": "saucership",
  "version": "0.0.0",
  "description": "saucership (a portmanteau of source and authorship) is a userscript that highlights text written by a given username within the source.",
  "author": "potatolover68 (User:MSK)",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --noEmit -p tsconfig.app.json --composite false",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@wikimedia/codex": "^1.0.1",
    "@wikimedia/codex-design-tokens": "^1.0.1",
    "@wikimedia/codex-icons": "^1.0.1",
    "diff-match-patch": "^1.0.5",
    "vite-plugin-mediawiki-userscript": "^0.6.0",
    "vue": "^3.3.4"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.3.3",
    "@tsconfig/node18": "^18.2.2",
    "@types/diff-match-patch": "^1.0.36",
    "@types/node": "^18.19.130",
    "@vitejs/plugin-vue": "^5.2.3",
    "@vitejs/plugin-vue-jsx": "^4.1.2",
    "@vue/eslint-config-typescript": "^12.0.0",
    "@vue/tsconfig": "^0.4.0",
    "eslint": "^8.49.0",
    "eslint-config-wikimedia": "^0.26.0",
    "eslint-plugin-vue": "^9.17.0",
    "npm-run-all2": "^6.1.1",
    "types-mediawiki": "^1.4.0",
    "typescript": "~5.2.0",
    "vite": "^6.2.6",
    "vue-tsc": "^2.2.8"
  }
}
