{
  "extends": [
    "../.eslintrc.cjs",
    "wikimedia/client/es6",
    "wikimedia/mediawiki",
    "wikimedia/vue3/es6"
  ],
  "env": {
    "jquery": true
  },
  "rules": {
    "es-x/no-optional-chaining": "off",
    "es-x/no-nullish-coalescing-operators": "off",
    "es-x/no-async-functions": "off",
    "es-x/no-rest-spread-properties": "off",
    "no-alert": "off",
    "no-void": "off",
    "no-unused-vars": ["error", { "args": "none" }],
    "no-undef": "off"
  }
}
